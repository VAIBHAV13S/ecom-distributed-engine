# MongoDB Databases for Microservices
MONGO_URI_IDENTITY=mongodb://mongo:27017/ecom-identity
MONGO_URI_CATALOG=mongodb://mongo:27017/ecom-catalog
MONGO_URI_CART=mongodb://mongo:27017/ecom-cart
MONGO_URI_ORDER=mongodb://mongo:27017/ecom-orders
MONGO_URI_BILLING=mongodb://mongo:27017/ecom-billing

# Security & Authentication
JWT_SECRET=ecom_jwt_super_secret_key_change_in_production

# Payment Gateway (Stripe)
STRIPE_SECRET_KEY=sk_test_placeholder_key

# Email Dispatcher (NodeMailer)
NODEMAILER_EMAIL=your_email@gmail.com
NODEMAILER_PASSWORD=your_app_password

# SMS Dispatcher (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
